# ============================================================
#  nginx para EcommerAdmin (SPA de Vite + React Router)
#
#  Plantilla: el entrypoint de nginx:alpine sustituye ${BACKEND_ORIGIN}
#  con envsubst al arrancar y deja el resultado en /etc/nginx/conf.d/default.conf
# ============================================================

# DNS interno de Docker. Hace falta porque proxy_pass usa una variable:
# asi el nombre del backend se resuelve en cada peticion y nginx arranca
# aunque el gateway todavia no este levantado.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Detras del proxy de Dokploy / Traefik el tamano real lo controla el, pero
    # la app sube imagenes y comprobantes, asi que no dejamos el limite en 1MB.
    client_max_body_size 25m;

    # Que no se anuncie la version exacta de nginx.
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/javascript
        application/javascript application/json application/xml
        image/svg+xml font/woff font/woff2;

    # --- Cabeceras de seguridad --------------------------------------
    # Equivalen a las de public/_headers, que solo entiende Firebase Hosting.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # --- Content-Security-Policy (desactivada a proposito) ------------
    # La CSP de public/_headers ("default-src 'self'; script-src 'self'
    # https://apis.google.com") rompe la app: el service worker de FCM hace
    # importScripts desde https://www.gstatic.com y el SDK llama a
    # *.googleapis.com, cosas que esa politica bloquea.
    # Esta version si contempla lo que la app usa de verdad. Antes de
    # descomentarla: revisa la consola del navegador y, si VITE_BACK_URL apunta
    # a un dominio distinto al del panel, agrega ese origen en connect-src.
    #
    # add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.google-analytics.com; worker-src 'self' blob:; frame-src 'self' https://*.firebaseapp.com; object-src 'none'; base-uri 'self'" always;

    # --- API: mismo origen, sin CORS ---------------------------------
    # El front pide "/api/..." (src/api/url.ts) y aqui se reenvia al gateway.
    # Con proxy_pass en variable hay que reponer la URI a mano.
    location /api/ {
        set $backend_origin ${BACKEND_ORIGIN};
        proxy_pass $backend_origin$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Reportes de Excel y cargas de imagenes pueden tardar.
        proxy_connect_timeout 10s;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;
        proxy_buffering       off;
    }

    # --- Service worker de FCM ---------------------------------------
    # Nunca cachear: si el navegador se queda con uno viejo, las notificaciones
    # dejan de llegar hasta que expire la cache.
    location = /firebase-messaging-sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        expires off;
    }

    # --- Assets con hash en el nombre --------------------------------
    # Vite renombra el archivo en cada build, asi que se pueden cachear para siempre.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # --- index.html --------------------------------------------------
    # Sin cache: es lo que apunta a los assets nuevos tras cada despliegue.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }

    # --- Fallback de la SPA ------------------------------------------
    # La app usa BrowserRouter: /pedidos, /dashboard... no existen como archivo.
    # Si no es un archivo real, se devuelve index.html y React Router resuelve.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # _headers es de Firebase Hosting; aqui no debe servirse.
    location = /_headers {
        return 404;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }
}
